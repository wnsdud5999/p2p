<html>
<head>
  <title>Caffein</title>
  <hta:application
    id="keepAwakeApp"
    applicationname="CodexKeepAwake"
    border="thin"
    borderstyle="normal"
    caption="yes"
    contextmenu="no"
    innerborder="no"
    maximizebutton="no"
    minimizebutton="yes"
    navigable="no"
    scroll="no"
    showintaskbar="yes"
    singleinstance="yes"
    sysmenu="yes"
    windowstate="normal"
  />
  <meta http-equiv="x-ua-compatible" content="IE=9" />
  <style>
    :root {
      --bg: #ffffff;
      --panel: #ffffff;
      --text: #000000;
      --muted: #000000;
      --line: #7a7a7a;
      --status-bg: #d9d9d9;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Segoe UI, Tahoma, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      padding: 18px;
    }

    .card {
      background: var(--panel);
      border: 2px solid #000000;
      padding: 18px;
    }

    h1 {
      margin: 0 0 10px;
      font-size: 30px;
      letter-spacing: -0.03em;
      font-weight: 800;
    }

    p {
      margin: 0 0 12px;
      color: var(--muted);
      line-height: 1.5;
      font-weight: 700;
    }

    .status {
      margin: 14px 0;
      padding: 14px;
      border: 2px solid var(--line);
      background: var(--status-bg);
    }

    .status strong {
      display: block;
      margin-bottom: 8px;
      font-weight: 800;
    }

    .ok {
      color: #000000;
    }

    .warn {
      color: #000000;
    }

    .controls {
      margin-top: 14px;
    }

    .field {
      margin-top: 14px;
    }

    label {
      display: block;
      margin-bottom: 6px;
      font-weight: 700;
    }

    select {
      width: 220px;
      padding: 10px 12px;
      border: 2px solid #000000;
      background: #ffffff;
      color: #000000;
      font: inherit;
      font-weight: 700;
    }

    .hint {
      margin-top: 6px;
      color: #000000;
      font-size: 14px;
      font-weight: 700;
    }

    button {
      margin-right: 10px;
      margin-bottom: 10px;
      padding: 10px 16px;
      border: 2px solid #000000;
      background: #ffffff;
      color: #000000;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }

    .secondary {
      background: #d9d9d9;
      color: #000000;
    }

    ul {
      margin: 14px 0 0;
      padding-left: 18px;
      color: var(--muted);
      line-height: 1.6;
      font-weight: 700;
    }

    code {
      color: #000000;
      font-family: Consolas, "Courier New", monospace;
      font-weight: 700;
    }
  </style>
  <script language="javascript">
    var shell = null;
    var timerId = null;
    var checkTimerId = null;
    var running = false;
    var intervalMs = 180000;
    var stopAt = null;

    function $(id) {
      return document.getElementById(id);
    }

    function nowText() {
      var d = new Date();
      return d.toLocaleTimeString();
    }

    function setStatus(message, cssClass) {
      $("statusText").innerText = message;
      $("statusText").className = cssClass || "";
      $("lastTick").innerText = nowText();
    }

    function pad(value) {
      return value < 10 ? "0" + value : "" + value;
    }

    function formatOptionLabel(hours24, minutes) {
      var meridian = hours24 >= 12 ? "PM" : "AM";
      var hours12 = hours24 % 12;
      if (hours12 === 0) {
        hours12 = 12;
      }
      return hours12 + ":" + pad(minutes) + " " + meridian;
    }

    function formatStopAt(dateValue) {
      return formatOptionLabel(dateValue.getHours(), dateValue.getMinutes());
    }

    function buildStopTimeOptions() {
      var select = $("stopAtInput");
      var option;
      var hours;
      var minutes;

      option = document.createElement("option");
      option.value = "";
      option.text = "No end time";
      select.options.add(option);

      for (hours = 0; hours < 24; hours += 1) {
        for (minutes = 0; minutes < 60; minutes += 30) {
          option = document.createElement("option");
          option.value = pad(hours) + ":" + pad(minutes);
          option.text = formatOptionLabel(hours, minutes);
          select.options.add(option);
        }
      }
    }

    function parseStopAt(value) {
      var parts;
      var hours;
      var minutes;
      var now;
      var target;

      if (!value) {
        return { value: null };
      }

      parts = value.split(":");
      hours = parseInt(parts[0], 10);
      minutes = parseInt(parts[1], 10);
      now = new Date();
      target = new Date(
        now.getFullYear(),
        now.getMonth(),
        now.getDate(),
        hours,
        minutes,
        0,
        0
      );

      if (target.getTime() <= now.getTime()) {
        target.setDate(target.getDate() + 1);
      }

      return { value: target };
    }

    function runningMessage() {
      var message = "Running. F15 is sent every 3 minutes.";
      if (stopAt) {
        message += " Stops at " + formatStopAt(stopAt) + ".";
      }
      message += " You can minimize this window.";
      return message;
    }

    function updateButtons() {
      $("startBtn").disabled = running;
      $("stopBtn").disabled = !running;
      $("stopAtInput").disabled = running;
    }

    function checkStopTime() {
      if (!running || !stopAt) {
        return;
      }

      if ((new Date()).getTime() >= stopAt.getTime()) {
        stopWake("Stopped at the selected time.", "warn");
      }
    }

    function sendWakeSignal() {
      try {
        if (!shell) {
          shell = new ActiveXObject("WScript.Shell");
        }
        shell.SendKeys("{F15}");
        setStatus(runningMessage(), "ok");
      } catch (e) {
        setStatus("Could not send the keep-awake signal: " + e.message, "warn");
        stopWake();
      }
    }

    function startWake() {
      var parsedStopAt;

      if (running) {
        return;
      }

      parsedStopAt = parseStopAt($("stopAtInput").value);
      if (parsedStopAt.error) {
        setStatus(parsedStopAt.error, "warn");
        return;
      }

      stopAt = parsedStopAt.value;
      running = true;
      sendWakeSignal();
      timerId = window.setInterval(sendWakeSignal, intervalMs);
      checkTimerId = window.setInterval(checkStopTime, 15000);
      updateButtons();
    }

    function stopWake(message, cssClass) {
      running = false;
      stopAt = null;
      if (timerId !== null) {
        window.clearInterval(timerId);
        timerId = null;
      }
      if (checkTimerId !== null) {
        window.clearInterval(checkTimerId);
        checkTimerId = null;
      }
      updateButtons();
      setStatus(message || "Stopped. Close the window to exit.", cssClass || "warn");
    }

    function init() {
      var width;
      var height;
      var left;
      var top;

      buildStopTimeOptions();
      updateButtons();
      setStatus("Ready.", "warn");

      try {
        width = 520;
        height = 560;
        left = Math.max(0, Math.round((screen.availWidth - width) / 2));
        top = Math.max(0, Math.round((screen.availHeight - height) / 2));
        window.resizeTo(width, height);
        window.moveTo(left, top);
      } catch (e) {
      }
    }

    window.onload = init;
    window.onbeforeunload = stopWake;
  </script>
</head>
<body>
  <div class="card">
    <h1>Caffein</h1>
    <p>
      Sends F15 every 3 minutes to help keep the computer awake.
    </p>

    <div class="status">
      <strong>Status</strong>
      <div id="statusText" class="warn">Loading...</div>
      <div style="margin-top:8px;color:#000000;font-weight:700;">Last update: <code id="lastTick">--:--:--</code></div>
    </div>

    <div class="field">
      <label for="stopAtInput">Keep Until</label>
      <select id="stopAtInput"></select>
      <div class="hint">Choose a time in 30-minute steps, or use No end time.</div>
    </div>

    <div class="controls">
      <button id="startBtn" onclick="startWake()">Start</button>
      <button id="stopBtn" class="secondary" onclick="stopWake()">Stop</button>
    </div>

  </div>
</body>
</html>
